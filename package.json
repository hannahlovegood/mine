{
  "name": "mine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mine · 由我 — a freedom layer for the web. The page adapts to the person, transparently and reversibly.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "demo": "npm run build && vite preview --port 4173 --strictPort --host",
    "plain": "tsx scripts/plain.ts"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
